{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemmio.local/schemas/conversation.v3.schema.json",
  "title": "Stemmio AI conversation v3",
  "type": "object",
  "required": ["schemaVersion", "conversationId", "projectId", "documentId", "title", "status", "createdAt", "updatedAt", "archivedAt", "activeContextId", "lastSequence", "revision", "contexts", "turns", "messages"],
  "properties": {
    "schemaVersion": { "const": "3.0.0" },
    "conversationId": { "type": "string", "pattern": "^conversation_[A-Za-z0-9_-]{12,180}$" },
    "projectId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "documentId": { "type": "string", "minLength": 1, "maxLength": 200 },
    "title": { "type": "string", "maxLength": 200 },
    "status": { "enum": ["active", "archived"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "archivedAt": { "type": ["string", "null"], "format": "date-time" },
    "activeContextId": { "type": ["string", "null"] },
    "lastSequence": { "type": "integer", "minimum": 0 },
    "revision": { "type": "integer", "minimum": 0 },
    "contexts": { "type": "array", "maxItems": 200, "items": { "type": "object" } },
    "turns": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/turn" } },
    "messages": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/message" } }
  },
  "$defs": {
    "nullableSelectionText": { "type": ["string", "null"], "maxLength": 160 },
    "reasoning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested", "applied", "resolution"],
      "properties": {
        "requested": { "$ref": "#/$defs/nullableSelectionText" },
        "applied": { "$ref": "#/$defs/nullableSelectionText" },
        "resolution": { "enum": ["exact", "provider-default", "unsupported"] }
      }
    },
    "providerSelection": {
      "type": ["object", "null"],
      "required": ["providerId", "runtimeId", "requestedModelId", "resolvedModelId", "reasoning"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "runtimeId": { "type": "string", "minLength": 1, "maxLength": 80 },
        "requestedModelId": { "$ref": "#/$defs/nullableSelectionText" },
        "resolvedModelId": { "$ref": "#/$defs/nullableSelectionText" },
        "reasoning": { "$ref": "#/$defs/reasoning" }
      }
    },
    "providerBinding": {
      "type": ["object", "null"],
      "required": ["providerId", "runtimeId"],
      "properties": {
        "providerId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "runtimeId": { "type": "string", "minLength": 1, "maxLength": 200 }
      }
    },
    "turn": {
      "type": "object",
      "required": ["turnId", "contextId", "mode", "status", "startedMessageId", "providerSelection", "providerBinding", "capabilitySnapshotFingerprint", "startedAt", "completedAt", "interruptedAt", "requestId", "attemptId", "candidateId"],
      "properties": {
        "turnId": { "type": "string" },
        "contextId": { "type": "string" },
        "mode": { "enum": ["discussion", "execution", "review-discussion"] },
        "status": { "enum": ["queued", "running", "completed", "interrupted", "failed", "cancelled"] },
        "startedMessageId": { "type": ["string", "null"] },
        "providerSelection": { "$ref": "#/$defs/providerSelection" },
        "providerBinding": { "$ref": "#/$defs/providerBinding" },
        "capabilitySnapshotFingerprint": { "type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$" },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": ["string", "null"], "format": "date-time" },
        "interruptedAt": { "type": ["string", "null"], "format": "date-time" },
        "requestId": { "type": ["string", "null"] },
        "attemptId": { "type": ["string", "null"] },
        "candidateId": { "type": ["string", "null"] }
      }
    },
    "message": {
      "type": "object",
      "required": ["messageId", "turnId", "sequence", "actor", "kind", "status", "text", "contextId", "createdAt", "completedAt", "parentMessageId", "providerId", "actualModelId", "modelDisplayName", "requestId", "attemptId", "candidateId"],
      "properties": {
        "messageId": { "type": "string" },
        "turnId": { "type": "string" },
        "sequence": { "type": "integer", "minimum": 1 },
        "actor": { "enum": ["user", "agent", "stemmio"] },
        "kind": { "enum": ["text", "progress", "decision-outcome", "error", "context-boundary", "permission-boundary", "result-summary", "process-summary"] },
        "status": { "enum": ["completed", "interrupted", "failed", "cancelled"] },
        "text": { "type": "string", "maxLength": 131072 },
        "contextId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": ["string", "null"], "format": "date-time" },
        "parentMessageId": { "type": ["string", "null"] },
        "providerId": { "type": ["string", "null"] },
        "actualModelId": { "type": ["string", "null"] },
        "modelDisplayName": { "type": ["string", "null"] },
        "requestId": { "type": ["string", "null"] },
        "attemptId": { "type": ["string", "null"] },
        "candidateId": { "type": ["string", "null"] }
      }
    }
  }
}
