{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemmio.local/schemas/project-manifest.v4.schema.json",
  "$comment": "Forward compatible. The manifest, each Version entry and each Working Copy entry are mutated in place and written back as the object that was read, so a member added by a newer Stemmio is preserved. `fileIdentity` is the exception: it is authored from a fresh stat on every save and stays strict. ADR 0022 forbids one specific member, a project-wide `fileNaming`, and that prohibition is stated directly rather than left to a blanket unknown-member rejection. The forward-compatible member rule is ADR 0057.",
  "type": "object",
  "not": { "anyOf": [
    { "required": ["fileNaming"] },
    { "required": ["retiredWorkingCopies"] }
  ] },
  "required": [
    "schemaVersion",
    "projectId",
    "documentId",
    "latestOfficialVersionId",
    "versions",
    "workingCopies",
    "currentDraftSchemaVersion"
  ],
  "properties": {
    "currentDraftSchemaVersion": { "const": "1.0.0" },
    "schemaVersion": { "const": "4.0.0" },
    "projectId": { "type": "string", "pattern": "^project_[a-f0-9]{16,64}$" },
    "documentId": { "type": "string", "pattern": "^doc_[a-f0-9]{16,64}$" },
    "latestOfficialVersionId": { "type": "string", "pattern": "^ver_\\d{4,}$" },
    "versions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "versionId",
          "ordinal",
          "basedOnVersionId",
          "previousVersionId",
          "contentSha256",
          "snapshotRelativePath",
          "sourceRequestId",
          "sourceCandidateId",
          "createdAt"
        ],
        "allOf": [{"if": {"required": ["sourceType"], "properties": {"sourceType": {"enum": ["history-copy", "local-save", "recovery-copy"]}}}, "then": {"required": ["sourceOperationId"], "properties": {"ordinal": {"type": "integer", "minimum": 2}, "basedOnVersionId": {"type": "string"}, "previousVersionId": {"type": "string"}, "sourceRequestId": {"type": "null"}, "sourceCandidateId": {"type": "null"}}}}],
        "properties": {
          "versionId": { "type": "string", "pattern": "^ver_\\d{4,}$" },
          "ordinal": { "type": "integer", "minimum": 1 },
          "basedOnVersionId": { "type": ["string", "null"], "pattern": "^ver_\\d{4,}$" },
          "previousVersionId": { "type": ["string", "null"], "pattern": "^ver_\\d{4,}$" },
          "contentSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
          "snapshotRelativePath": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+" },
          "sourceType": { "enum": ["initial", "internal-ai", "history-copy", "local-save", "recovery-copy"] },
          "sourceOperationId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{8,160}$" },
          "sourceRequestId": { "type": ["string", "null"] },
          "sourceCandidateId": { "type": ["string", "null"] },
          "createdAt": { "type": "string", "format": "date-time" }
        }
      }
    },
    "workingCopies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "required": [
          "workingCopyId",
          "versionId",
          "basedOnVersionId",
          "sourceRelativePath",
          "preferredFileStem",
          "preferredExtension",
          "stateRelativePath",
          "fileIdentity"
        ],
        "properties": {
          "workingCopyId": { "type": "string", "pattern": "^work_ver_\\d{4,}$" },
          "versionId": { "type": "string", "pattern": "^ver_\\d{4,}$" },
          "basedOnVersionId": { "type": "string", "pattern": "^ver_\\d{4,}$" },
          "sourceRelativePath": {
            "type": "string",
            "pattern": "^(?!.*[/\\\\\\u0000-\\u001F]).+\\.(?:html|htm)$"
          },
          "preferredFileStem": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "pattern": "^(?!.*[\\u0000-\\u001F\\u007F/\\\\]).+$"
          },
          "preferredExtension": { "enum": [".html", ".htm"] },
          "stateRelativePath": { "type": "string", "pattern": "^working-copies/(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.json$" },
          "fileIdentity": {
            "type": "object",
            "additionalProperties": false,
            "required": ["device", "inode", "birthtimeMs"],
            "properties": {
              "device": { "type": "string" },
              "inode": { "type": "string" },
              "birthtimeMs": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    }
  }
}
