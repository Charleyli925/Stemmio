{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stemmio.local/schemas/project-runtime-state.v4.schema.json",
  "$comment": "Strict current writer schema. Forward compatible per level. `activeRequest` is replaced with a fresh record on every status transition and `lastAiTask` is re-derived from the AI task record, so both are authored and stay strict. Historical activation receipts are rejected; Registry ingress alone discards the shipped inert `historyActivation: null` tombstone without making it writable.",
  "type": "object",
  "not": { "required": ["historyActivation"] },
  "required": [
    "schemaVersion",
    "projectId",
    "documentId",
    "activeWorkingCopyId",
    "activeRequest",
    "activeCandidateId"
  ],
  "properties": {
    "schemaVersion": { "const": "4.0.0" },
    "projectId": { "type": "string", "pattern": "^project_[a-f0-9]{16,64}$" },
    "documentId": { "type": "string", "pattern": "^doc_[a-f0-9]{16,64}$" },
    "historyCreation": {"type": ["object", "null"], "required": ["operationId", "versionId"], "properties": {"operationId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{8,160}$"}, "versionId": {"type": "string", "pattern": "^ver_\\d{4,}$"}}},
    "activeWorkingCopyId": { "type": ["string", "null"], "pattern": "^work_ver_\\d{4,}$" },
    "activeRequest": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "requestId",
        "candidateId",
        "attemptId",
        "status",
        "inputManifestSha256",
        "candidateOutputSha256",
        "candidateRecordSha256"
      ],
      "properties": {
        "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,160}$" },
        "candidateId": { "type": ["string", "null"], "pattern": "^candidate_[A-Za-z0-9_-]{8,160}$" },
        "attemptId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,160}$" },
        "status": { "enum": ["processing", "pending-review"] },
        "inputManifestSha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "candidateOutputSha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "candidateRecordSha256": {
          "type": ["string", "null"],
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "processing" } } },
          "then": {
            "properties": {
              "candidateId": { "const": null },
              "candidateOutputSha256": { "const": null },
              "candidateRecordSha256": { "const": null }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "pending-review" } } },
          "then": {
            "properties": {
              "candidateId": {
                "type": "string",
                "pattern": "^candidate_[A-Za-z0-9_-]{8,160}$"
              },
              "candidateOutputSha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "candidateRecordSha256": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              }
            }
          }
        }
      ]
    },
    "activeCandidateId": { "type": ["string", "null"], "pattern": "^candidate_[A-Za-z0-9_-]{8,160}$" },
    "lastAiTask": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "requestId",
        "attemptId",
        "candidateId",
        "projectId",
        "documentId",
        "sourceWorkingCopyId",
        "expectedSourceSha256",
        "inputManifestSha256",
        "status",
        "completedAt"
      ],
      "properties": {
        "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,160}$" },
        "attemptId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,160}$" },
        "candidateId": { "type": "string", "pattern": "^candidate_[A-Za-z0-9_-]{8,160}$" },
        "projectId": { "type": "string", "pattern": "^project_[a-f0-9]{16,64}$" },
        "documentId": { "type": "string", "pattern": "^doc_[a-f0-9]{16,64}$" },
        "sourceWorkingCopyId": { "type": "string", "pattern": "^work_ver_\\d{4,}$" },
        "expectedSourceSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "inputManifestSha256": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "status": { "enum": ["no-change", "error"] },
        "completedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "activeRequest": { "type": "null" }
        }
      },
      "then": {
        "properties": {
          "activeCandidateId": { "const": null }
        }
      }
    },
    {
      "if": {
        "properties": {
          "activeRequest": { "type": "object" }
        }
      },
      "then": {
        "properties": {
          "activeWorkingCopyId": { "type": "string" },
          "lastAiTask": { "const": null }
        }
      }
    }
  ]
}
