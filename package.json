{
  "name": "stemmio",
  "version": "0.9.89",
  "description": "源页（Stemmio）— Editable islands with byte-exact source outside every edited region.",
  "author": "源页",
  "license": "Apache-2.0",
  "private": true,
  "homepage": "https://github.com/Charleyli925/Stemmio#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Charleyli925/Stemmio.git"
  },
  "bugs": {
    "url": "https://github.com/Charleyli925/Stemmio/issues"
  },
  "main": "desktop/main.mjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log node scripts/dev.mjs",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "desktop:renderer": "vite build --config desktop/vite.config.ts",
    "desktop:dev": "npm run desktop:renderer && STEMMIO_RUNTIME_CHANNEL=source electron desktop/main.mjs",
    "desktop:pack": "npm run desktop:renderer && node scripts/build-package.mjs --arch arm64",
    "ci:source-build": "npm run typecheck && npm run lint && npm run build",
    "architecture:check": "node scripts/check-architecture.mjs",
    "adr:check": "node scripts/check-adrs.mjs",
    "typecheck": "npm run architecture:check && tsc --noEmit && npm run typecheck:source-receipt && npm run typecheck:document-source-operation && npm run typecheck:agent-credential-operation && npm run typecheck:browser-open",
    "typecheck:source-receipt": "tsc --noEmit -p tsconfig.source-receipt.json && node scripts/verify-source-receipt-typecheck.mjs",
    "typecheck:document-source-operation": "tsc --noEmit -p tsconfig.document-source-operation.json",
    "typecheck:agent-credential-operation": "tsc --noEmit -p tsconfig.agent-credential-operation.json",
    "typecheck:browser-open": "tsc --noEmit -p tsconfig.browser-open-workflow.json",
    "test": "npm run test:node:full",
    "test:node:core": "node scripts/test-node-group.mjs core",
    "test:node:smoke": "node scripts/test-node-group.mjs smoke",
    "test:contract": "node scripts/test-node-group.mjs contract",
    "test:node:integration": "npm run build && node scripts/test-node-group.mjs integration",
    "test:node:full": "npm run build && node scripts/test-node-group.mjs full",
    "test:browser:smoke": "npm run build && playwright test --config tests/e2e/browser/playwright.smoke.config.mjs",
    "test:browser:full": "npm run build && playwright test --config tests/e2e/browser/playwright.config.mjs",
    "test:real-html:electron": "node tests/e2e/electron/frozen-html-scenarios.mjs",
    "test:dom-editing-compatibility": "npm run build && playwright test --config tests/e2e/browser/playwright.real-html.config.mjs",
    "test:real-html": "npm run test:dom-editing-compatibility",
    "test:electron:smoke": "npm run desktop:renderer && playwright test --config tests/e2e/electron/playwright.smoke.config.mjs",
    "test:electron:ci-preflight": "playwright test --config tests/e2e/electron/playwright.ci-preflight.config.mjs",
    "test:electron:full": "npm run desktop:renderer && playwright test --config tests/e2e/electron/playwright.config.mjs",
    "test:ai-closed-loop:smoke": "npm run desktop:renderer && playwright test --config tests/e2e/electron/playwright.ai-smoke.config.mjs",
    "test:ai-closed-loop": "npm run desktop:renderer && playwright test --config tests/e2e/electron/playwright.ai-closed-loop.config.mjs",
    "test:packaged-runtime": "playwright test --config tests/e2e/electron/playwright.packaged.config.mjs",
    "test:packaged-startup": "playwright test --config tests/e2e/electron/playwright.packaged-startup.config.mjs",
    "test:bridge": "node --test tests/workspace-bridge.test.mjs",
    "spike:qoder-acp": "node scripts/qoder-acp-spike.mjs",
    "smoke:agent-vendors:real": "node scripts/smoke-openai-compatible-vendors.mjs --require-all",
    "benchmark:review-analysis": "node scripts/benchmark-review-analysis.mjs",
    "benchmark:html-workflows": "node scripts/benchmark-html-workflows.mjs",
    "benchmark:persistence": "npm run desktop:renderer && node scripts/benchmark-persistence.mjs",
    "test:inventory": "node scripts/generate-test-inventory.mjs",
    "test:package": "node scripts/test-node-group.mjs package",
    "verify:packaged": "node scripts/verify-packaged-artifact.mjs --arch arm64",
    "release:assets": "node scripts/create-release-assets.mjs",
    "release:notes": "node scripts/release-notes.mjs",
    "audit:dependencies": "node scripts/check-dependency-audit.mjs",
    "pr:candidate": "node scripts/classify-pr-candidate.mjs",
    "review:snapshot": "node scripts/check-pr-review-policy.mjs",
    "ci:health": "node scripts/ci-health-report.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern dist-desktop --ignore-pattern release --ignore-pattern .next",
    "task:status": "node scripts/task-workflow.mjs status",
    "task:start": "node scripts/task-workflow.mjs start",
    "task:attach": "node scripts/task-workflow.mjs attach",
    "task:finish": "node scripts/task-workflow.mjs finish",
    "task:audit": "node scripts/task-workflow.mjs audit",
    "task:retire": "node scripts/task-workflow.mjs retire",
    "task:sync-main": "node scripts/task-workflow.mjs sync-main",
    "task:policy": "node scripts/task-workflow.mjs policy",
    "gate:edit": "node scripts/test-gate.mjs edit",
    "gate:draft": "node scripts/test-gate.mjs draft",
    "gate:plan": "node scripts/test-gate.mjs plan",
    "gate:task": "node scripts/test-gate.mjs task",
    "gate:main:auto": "node scripts/test-gate.mjs main",
    "gate:release:auto": "node scripts/test-gate.mjs release",
    "gate:developer-package": "node scripts/test-gate.mjs developer-package --arch arm64",
    "gate:candidate-app:auto": "node scripts/test-gate.mjs candidate-app --arch arm64",
    "gate:artifact:auto": "node scripts/test-gate.mjs artifact --arch arm64",
    "verify": "npm run gate:task",
    "package:developer": "npm run gate:developer-package",
    "release:mac": "npm run gate:artifact:auto"
  },
